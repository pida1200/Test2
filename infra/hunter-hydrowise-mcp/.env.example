# Zkopíruj na .env a vyplň (na serveru ~/hunter-hydrowise-mcp/.env).
# https://github.com/skialpine/hunter-hydrowise-mcp

HYDRAWISE_USERNAME=
HYDRAWISE_PASSWORD=

# IP tohoto stroje v LAN (Host header z Cursoru musí sedět s hostGuard).
HYDRAWISE_MCP_HOST=192.168.1.123
HYDRAWISE_MCP_PORT=8765

# Povinné při bindu na ne-loopback (viz upstream README).
# Vygeneruj: openssl rand -hex 32
HYDRAWISE_MCP_AUTH_TOKEN=

# Volitelné: více hodnot čárkou, pokud klient posílá Origin a dostáváš 403.
# HYDRAWISE_MCP_ALLOWED_ORIGINS=http://127.0.0.1:8765

HYDRAWISE_LOG_LEVEL=warn
