# Zkopíruj do `mujdum/.env`. Docker Compose (`backend.env_file`) tyto hodnoty předává do backendu.

# Povinné pro synchronizaci dashboardu a číselníku místností z Home Assistant:
HOME_ASSISTANT_URL=http://192.168.1.119:8123
HOME_ASSISTANT_TOKEN=

# Volitelné – výchozí interval HA sync v ms, pokud v DB ještě není hodnota z UI Nastavení (5000–600000):
# DASHBOARD_SYNC_INTERVAL_MS=30000

# Při spuštění backendu přes docker-compose.yml se ELASTICSEARCH_URL nastavuje automaticky z Compose.
# Jen pokud spouštíš backend mimo tento stack, doplň např.:
# ELASTICSEARCH_URL=http://localhost:9200

# Sport (TheSportsDB) — https://www.thesportsdb.com/pricing
# Veřejný free klíč (v1, 30 req/min, omezená data): 123 — vlastní klíč z registrace pro delší provoz
# THESPORTSDB_API_KEY=123
# Volitelně výchozí tým pro: cd mujdum/backend && npm run sports:sync-test
# SPORTS_TEST_TEAM_ID=133602

# Fallback interval sport sync v ms, pokud není v Nastavení (UI ukládá do app_settings; výchozí 180000 = 3 min)
# SPORT_SYNC_INTERVAL_MS=180000
